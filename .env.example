# Адрес бэкенда. По умолчанию пусто: запросы идут на свой origin, а дальше их
# переправляет прокси (vite.config.js в разработке, vercel.json в продакшене) —
# бэкенд пока не отдаёт CORS-заголовки.
#
# Задайте адрес, чтобы ходить к серверу напрямую, минуя прокси:
# VITE_API_URL=https://setanta.pythonanywhere.com
#
# Схема API: https://setanta.pythonanywhere.com/api/v1/schema
VITE_API_URL=
